DATABASE_URL=postgres://hof:hof_dev_password@localhost:5432/hands_on_fitness
PORT=3000
# Free key from https://console.groq.com → API Keys (never commit the real key)
GROQ_API_KEY=
# ZeptoMail transactional email (https://www.zoho.com/zeptomail) — token from your Mail Agent → SMTP/API tab
ZEPTOMAIL_API_KEY=
# Must be an address on your verified ZeptoMail domain, e.g. welcome@yourdomain.com
ZEPTOMAIL_FROM=
ZEPTOMAIL_FROM_NAME=Hands-On Fitness
# EU accounts only: ZEPTOMAIL_BASE=https://api.zeptomail.eu/v1.1/email
# Paystack test keys (https://dashboard.paystack.com → Settings → API Keys). Live keys later for real money.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Spotify Web API (free — https://developer.spotify.com → Dashboard → Create app)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Google Calendar (free — Google Cloud → enable Calendar API → OAuth client Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the redirect URI in your OAuth client exactly:
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# LiveKit self-hosted (local dev defaults work with docker compose; override for prod)
LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secretdontsharelocalonly
